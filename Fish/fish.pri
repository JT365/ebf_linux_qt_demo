INCLUDEPATH         += $$PWD/src

HEADERS += \
    $$PWD/src/fish.h \
    $$PWD/src/magic_fish.h \
    $$PWD/src/magic_pool.h \
    $$PWD/src/qtfishtoolbar.h 

SOURCES += \
    $$PWD/src/fish.cpp \
    $$PWD/src/magic_fish.cpp \
    $$PWD/src/magic_pool.cpp \
    $$PWD/src/qtfishtoolbar.cpp 
